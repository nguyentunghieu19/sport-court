spring.application.name=backend
server.port=8080

# Kết nối PostgreSQL: copy file này thành application.properties rồi sửa 3 giá trị viết hoa
spring.datasource.url=jdbc:postgresql://localhost:5432/SPORTCOURT
spring.datasource.username=postgres
spring.datasource.password=123

spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false
spring.jpa.show-sql=true

# Cấu hình JWT: khóa phải dài ít nhất 32 ký tự, hãy đổi thành chuỗi ngẫu nhiên của bạn
app.jwt.secret=DOI_THANH_CHUOI_NGAU_NHIEN_DAI_IT_NHAT_32_KY_TU
app.jwt.expiration-minutes=60


# Cấu hình VNPay sandbox: lấy TmnCode và HashSecret từ email đăng ký sandbox của VNPay
app.vnpay.tmn-code=MA_TMN_CODE_CUA_BAN
app.vnpay.hash-secret=HASH_SECRET_CUA_BAN
app.vnpay.pay-url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
app.vnpay.return-url=http://localhost:8080/api/public/payments/vnpay/return

# Cloudinary: có thể đặt trực tiếp trong application.properties cá nhân (đã bị gitignore),
# hoặc cấu hình 3 biến môi trường bên dưới rồi khởi động lại backend.
app.cloudinary.cloud-name=${CLOUDINARY_CLOUD_NAME:}
app.cloudinary.api-key=${CLOUDINARY_API_KEY:}
app.cloudinary.api-secret=${CLOUDINARY_API_SECRET:}
# Các giá trị này không được đưa vào React/Android hoặc commit khóa thật lên Git.
